@startuml
title GET /loans/{loanId} - Get Loan Details

participant "Client" as C
participant "API Gateway / Auth Middleware" as Auth
participant "LoanController" as LC
participant "ILoanService" as LS
participant "ILoanRepository" as LR
participant "IAccountRepository" as AR
participant "[DB]" as DB

C -> Auth: GET /loans/{loanId} \nAuthorization: Bearer <token>
activate Auth
Auth -> Auth: Validate Token
Auth -> LC: Forward Request (with authenticatedUserId, isAdmin flag)
deactivate Auth
activate LC
LC -> LS: GetLoanById(loanId, authenticatedUserId, isAdmin)
activate LS
LS -> LR: FindLoanById(loanId)
activate LR
LR -> DB: Execute SELECT Loan query
activate DB
DB --> LR: Loan Record (or null)
deactivate DB
alt Loan Not Found
  LR --> LS: null
  deactivate LR
  LS --> LC: Error Result (NotFoundException)
  deactivate LS
  LC -> C: 404 Not Found \nContent: ErrorDto
  deactivate LC
else Loan Found
  LR --> LS: LoanModel
  deactivate LR
  LS -> AR: FindAccountsByIds([loanModel.fromAccountId, loanModel.toAccountId]) ' For ownership check
  activate AR
  AR -> DB: Execute SELECT Account query (with User info)
  activate DB
  DB --> AR: Account Records
  deactivate DB
  AR --> LS: List<AccountModel> (fromAccount, toAccount)
  deactivate AR
  LS -> LS: Check Permission (Is Admin or Owner of FromAccount or ToAccount?)
  alt Permission Denied
    LS --> LC: Error Result (ForbiddenException)
    deactivate LS
    LC -> C: 403 Forbidden \nContent: ErrorDto
    deactivate LC
  else Permission Granted
    LS -> LS: Map LoanModel to LoanDetailDto (potentially enriching with account details)
    LS --> LC: LoanDetailDto
    deactivate LS
    LC -> C: 200 OK \nContent: LoanDetailDto
    deactivate LC
  end
end

@enduml